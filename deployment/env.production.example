# Public console domain. For a local production-style run, use :80.
V2FRAUDGENT_DOMAIN=:80

# Razorpay webhook secret from the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=replace_with_your_webhook_secret

# Browser origin allowed to call the backend directly.
# With the bundled Caddy console, use the same origin as V2FRAUDGENT_DOMAIN.
V2FRAUDGENT_CORS_ORIGINS=http://localhost

# Console Basic Auth. Keep the real password only in the deployment secret store.
CADDY_DASHBOARD_USER=admin
CADDY_DASHBOARD_PASSWORD=replace_with_a_strong_password
