{$V2FRAUDGENT_DOMAIN} {
    encode gzip

    @webhook path /razorpay/webhook
    handle @webhook {
        reverse_proxy backend:8012
    }

    @health path /health
    handle @health {
        reverse_proxy backend:8012
    }
    
        # Public browser API for the Vercel frontend.
    # Only requests under /public-api/ bypass dashboard Basic Auth.
    @public_api {
        path /public-api/*
        method GET POST OPTIONS
    }

    handle @public_api {
        uri strip_prefix /public-api
        reverse_proxy backend:8012
    }

    @api path /api/*
    handle @api {
        basic_auth {
            {$CADDY_DASHBOARD_USER} {$CADDY_DASHBOARD_HASH}
        }
        reverse_proxy backend:8012
    }

    handle {
        basic_auth {
            {$CADDY_DASHBOARD_USER} {$CADDY_DASHBOARD_HASH}
        }

        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}